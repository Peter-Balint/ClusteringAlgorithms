<Window x:Class="Clustering.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Clustering.View"
        xmlns:viewmodel="clr-namespace:Clustering.ViewModel"
        mc:Ignorable="d"
        Title="Clustering" 
        Height="720" Width="1280" ResizeMode="CanMinimize">
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type viewmodel:ParametersViewModel}">
                <local:ParametersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodel:SetupViewModel}">
                <local:SetupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodel:ResultsViewModel}">
                <local:ResultsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodel:LayoutViewModel}">
                <local:Layout />
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentControl Grid.Row ="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
