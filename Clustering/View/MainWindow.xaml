<Window x:Class="Clustering.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Clustering.View"
        xmlns:component="clr-namespace:Clustering.View.Components"
        xmlns:viewmodel="clr-namespace:Clustering.ViewModel"
        xmlns:custom="clr-namespace:ModalControl;assembly=ModalControl"
        mc:Ignorable="d"
        Title="Clustering" 
        Height="720" Width="1280" ResizeMode="CanMinimize">
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type viewmodel:ParametersViewModel}">
                <local:ParametersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodel:SetupViewModel}">
                <local:SetupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodel:ResultsViewModel}">
                <local:ResultsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodel:LayoutViewModel}">
                <local:Layout />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodel:ProgressViewModel}">
                <component:Progress />
            </DataTemplate>
        </Grid.Resources>

        <custom:Modal Panel.ZIndex="1" IsOpen="{Binding IsOpen}">
            <ContentControl Content="{Binding CurrentModalViewModel}" />
        </custom:Modal>

        <ContentControl Grid.Row ="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
