<UserControl x:Class="Clustering.View.Components.DisplaySpatial2D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clustering.View.Components"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

            <!--canvas "mozgatása": koordináták a viewmodelben változnak
            a mutatott helyzet a modellből vett koordináta plusz transzformáció a viewmodelben
            zoomolás: méret és koordináta változtatása
            kell majd egy kis matek
            honnan tudom a canvas méretét?
            -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="#F4F8D3">
            <TextBlock Name="SelectedPointInfo" HorizontalAlignment="Center" TextAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}Selected point:&#10;{0}, {1}">
                        <Binding Path="SelectedPoint.X" />
                        <Binding Path="SelectedPoint.Y" />
                    </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPoint}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Name="CanvasPointInfo" HorizontalAlignment="Center" TextAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}Clicked on canvas:&#10;{0}, {1}">
                        <Binding Path="ClickedX" />
                        <Binding Path="ClickedY" />
                    </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ClickedX}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="Add point" Command="{Binding AddPointCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ClickedX}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Remove point" Command="{Binding RemovePointCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPoint}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Border BorderBrush="Black" BorderThickness="3" Grid.Column="1">
            <!--<ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseWheel">
                        <i:InvokeCommandAction Command="{Binding ZoomCommand}"
                           PassEventArgsToCommand="True"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>-->
            <!--width binding doesn't work this way-->
            <ItemsControl x:Name="ic" ItemsSource="{Binding Points}" Background="Aquamarine" Width="{Binding ICWidth, Mode=OneWayToSource}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseWheel">
                        <i:InvokeCommandAction Command="{Binding ZoomCommand}" PassEventArgsToCommand="True"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <ItemsControl.Resources>
                        <ScaleTransform x:Key="ZoomTransform"
                            ScaleX="{Binding ZoomFactor}"
                            ScaleY="{Binding ZoomFactor}" />
                    </ItemsControl.Resources>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse StrokeThickness="3" Width="{Binding Diameter}" Height="{Binding Diameter}" Fill="BlueViolet">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonDown">
                                        <i:InvokeCommandAction 
                                            Command="{Binding OnClickCommand}"
                                            PassEventArgsToCommand="False"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="Black" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas RenderTransform="{StaticResource ZoomTransform}"  Background="PaleGoldenrod" ClipToBounds="True"
                                    Width="{Binding CanvasWidth}"
                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonDown">
                                        <!--add a select and a drag mode-->
                                        <i:InvokeCommandAction 
                                                    Command="{Binding CanvasClickedCommand}"
                                                    PassEventArgsToCommand="True"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Canvas>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding PutCenterToX}" />
                            <Setter Property="Canvas.Top" Value="{Binding PutCenterToY}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            <!--</ScrollViewer>-->
        </Border>
    </Grid>
</UserControl>
