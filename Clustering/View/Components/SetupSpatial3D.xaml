<UserControl x:Class="Clustering.View.Components.SetupSpatial3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clustering.View.Components"
             
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="#F4F8D3">
            <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="XTextBox" Width="60" Text="0" Margin="0,0,10,0"/>
            <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="YTextBox" Width="60" Text="0" Margin="0,0,10,0"/>
            <TextBlock Text="Z:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="ZTextBox" Width="60" Text="0" Margin="0,0,20,0"/>
            <Button  Content="Add Sphere"
                Margin="5"
                Width="100"
                Click="AddSphereButton_Click"/>
            <Button  Content="Load Points"
                Margin="5"
                Width="100"
                Click="LoadPointsButton_Click"/>
        </StackPanel>
        <h:HelixViewport3D x:Name="Viewport" Grid.Column="1" Background="Black" >

            <h:HelixViewport3D.Camera>
                <PerspectiveCamera Position="10,10,10"
                       LookDirection="-10,-10,-10"
                       UpDirection="0,1,0" />
            </h:HelixViewport3D.Camera>

            <h:DefaultLights />

            <h:GridLinesVisual3D></h:GridLinesVisual3D>

        </h:HelixViewport3D>
    </Grid>
</UserControl>
