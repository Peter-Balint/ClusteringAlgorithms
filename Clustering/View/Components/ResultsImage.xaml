<UserControl x:Class="Clustering.View.Components.ResultsImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clustering.View.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="#F4F8D3">
            <Button Content="Step Back" Command="{Binding StepBackCommand}" Margin="10"/>
            <Button Content="Step Forwards" Command="{Binding StepForwardsCommand}" Margin="10"/>
            <TextBlock Text="{Binding CurrentStep, StringFormat={}Current step: {0}}" HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
        <Image Grid.Column="1" Source="{Binding CurrentImage}"></Image>
    </Grid>
</UserControl>
