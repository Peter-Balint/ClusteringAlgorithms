<UserControl x:Class="Clustering.View.Components.ResultsSpatial3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clustering.View.Components"
             
             xmlns:h="http://helix-toolkit.org/wpf"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="#F4F8D3">
            <Button  Content="Step Back"
                Margin="5"
                Width="100"
                Click="StepBackButton_Click"/>
            <Button Content="Step Forward"
                Margin="5"
                Width="100"
                Click="StepForwardButton_Click"/>
            <TextBlock Name="CurrentStepTextBlock" Text="Current step: 0" HorizontalAlignment="Center"/>
        </StackPanel>
        <h:HelixViewport3D x:Name="Viewport" Grid.Column="1" Background="Black">

            <h:HelixViewport3D.Camera>
                <PerspectiveCamera Position="10,10,10"
               LookDirection="-10,-10,-10"
               UpDirection="0,1,0" />
            </h:HelixViewport3D.Camera>

            <h:DefaultLights />

            <h:GridLinesVisual3D></h:GridLinesVisual3D>

        </h:HelixViewport3D>
    </Grid>
</UserControl>
