<UserControl x:Class="Clustering.View.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clustering.View"
             xmlns:vm="clr-namespace:Clustering.ViewModel"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Resources/EnumConversion.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            FontSize="28"
            Text="Parameters"
            Margin="10"
            />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Label>Point Type</Label>
                <!--ItemsSource="{Binding Source={StaticResource DisplayModeEnum}}"-->
                <ComboBox 
                    ItemsSource="{Binding DisplayModeValues, Mode=OneTime}"
                    SelectedItem="{Binding DisplayMode}"
                    Height="20" Width="150" HorizontalAlignment="Left" Margin="10"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
