<UserControl x:Class="Clustering.View.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clustering.View"
             xmlns:vm="clr-namespace:Clustering.ViewModel"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Resources/EnumConversion.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>-->
        <Style TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            FontSize="28"
            Text="Parameters"
            Margin="10"
            />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border BorderBrush="Black" BorderThickness="1" Margin="10" Width="300" CornerRadius="10" Padding="10">
                    <StackPanel>
                        <Label>Point Type</Label>
                        <ComboBox 
                            ItemsSource="{Binding DisplayModeValues, Mode=OneTime}"
                            SelectedItem="{Binding DisplayMode}"/>
                    </StackPanel>
                </Border>
                <Label>Spatial Distance Metric</Label>
                <ComboBox 
                    ItemsSource="{Binding SpatialDistanceMetricValues, Mode=OneTime}"
                    SelectedItem="{Binding SpatialDistanceMetric}"/>
                <Label>Center Type</Label>
                <ComboBox 
                    ItemsSource="{Binding CenterTypeValues, Mode=OneTime}"
                    SelectedItem="{Binding CenterType}"/>
                <Label>Terminate Condition</Label>
                <ComboBox 
                    ItemsSource="{Binding TerminateConditionValues, Mode=OneTime}"
                    SelectedItem="{Binding TerminateCondition}"/>
                <!--<TextBox Height="20" Width="150" HorizontalAlignment="Left" Margin="10"></TextBox>-->
                <Label>Cluster Initialization Method</Label>
                <ComboBox
                    ItemsSource="{Binding ClusterInitializationMethodValues, Mode=OneTime}"
                    SelectedItem="{Binding ClusterInitializationMethod}" />
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
