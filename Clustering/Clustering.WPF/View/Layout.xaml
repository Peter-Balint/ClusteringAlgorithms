<UserControl x:Class="Clustering.View.Layout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clustering.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <local:NavigationBar Grid.Row="1" DataContext="{Binding NavigationBarViewModel}" 
                             Visibility="{Binding DataContext.IsNavigationEnabled, ElementName=LayoutRoot, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <ContentControl
        Grid.Row="0"
        Content="{Binding ContentViewModel}" />

    </Grid>
</UserControl>
