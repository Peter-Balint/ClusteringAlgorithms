<UserControl x:Class="Clustering.View.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clustering.View"
             xmlns:vm="clr-namespace:Clustering.ViewModel"
                          xmlns:i="http://schemas.microsoft.com/xaml/behaviors"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="RoundedBorderStyleBlack" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="28"
            Text="Parameters"
            Margin="10"
            />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Primary parameters" FontSize="22" Margin="10" HorizontalAlignment="Center"></TextBlock>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}">
                        <StackPanel>
                            <Label>Point Type</Label>
                            <ComboBox 
                                ItemsSource="{Binding DisplayModeValues, Mode=OneTime}"
                                SelectedItem="{Binding DisplayMode}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}">
                        <StackPanel>
                            <Label>Center Type</Label>
                            <ComboBox 
                                ItemsSource="{Binding CenterTypeValues, Mode=OneTime}"
                                SelectedItem="{Binding CenterType}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}">
                        <StackPanel>
                            <Label>Terminate Condition</Label>
                            <ComboBox 
                                ItemsSource="{Binding TerminateConditionValues, Mode=OneTime}"
                                SelectedItem="{Binding TerminateCondition}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}" Visibility="{Binding IsClusterInitializationMethodApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Label>Cluster Initialization Method</Label>
                            <ComboBox
                                ItemsSource="{Binding ClusterInitializationMethodValues, Mode=OneTime}"
                                SelectedItem="{Binding ClusterInitializationMethod}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}">
                        <StackPanel>
                            <Label>Randomization</Label>
                            <ComboBox
                                ItemsSource="{Binding RandomizationTypeValues, Mode=OneTime}"
                                SelectedItem="{Binding RandomizationType}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}">
                        <StackPanel>
                            <Label>Number of Clusters (K)</Label>
                            <TextBox Text="{Binding InitialClusterNumberDisplay, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}">
                            </TextBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Secondary parameters" FontSize="22" Margin="10" HorizontalAlignment="Center"></TextBlock>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}" Visibility="{Binding IsSpatialDistanceMetricApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Label>Spatial Distance Metric</Label>
                            <ComboBox 
                                ItemsSource="{Binding SpatialDistanceMetricValues, Mode=OneTime}"
                                SelectedItem="{Binding SpatialDistanceMetric}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}" Visibility="{Binding IsIterationNumberApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Label>Iteration Number</Label>
                            <TextBox Text="{Binding IterationNumberDisplay, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}">
                            </TextBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}" Visibility="{Binding IsMinimalDeltaApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Label>Minimal Delta</Label>
                            <TextBox Text="{Binding MinimalDeltaDisplay, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RoundedBorderStyleBlack}" Visibility="{Binding IsSeedApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Label>Seed</Label>
                            <TextBox Text="{Binding SeedDisplay, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="Apply" Grid.Row="0" Command="{Binding ApplyCommand}"
                        Height="40" Width="100" FontSize="20" Margin="15">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Cancel" Grid.Row="1" Command="{Binding CancelCommand}"
                        Height="40" Width="100" FontSize="20" Margin="15"
                            IsEnabled="{Binding HasPreviousState}"/>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Errors" FontSize="22" Margin="10" HorizontalAlignment="Center"></TextBlock>
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding ErrorMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="18" TextAlignment="Center" 
                                                           Foreground="PaleVioletRed" TextWrapping="Wrap" Margin="10"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                 
                </Grid>
            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
